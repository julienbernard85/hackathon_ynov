# Serveur local (le frontend utilise déjà le port 3000)
HOST=127.0.0.1
PORT=3002

# Groq utilise le SDK OpenAI-compatible
OPENAI_API_KEY=
BASE_URL=https://api.groq.com/openai/v1
MODEL=llama-3.1-8b-instant

# Sécurité
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
# BACKEND_API_KEY=
